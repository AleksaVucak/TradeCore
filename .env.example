# ──────────────────────────────────────────────────────────────
#  TradeCore — Environment Variables
#  Copy this file to .env and fill in real values for production.
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://tradecore:tradecore@postgres:5432/tradecore

# ── Redis (broker + cache) ───────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ── Auth ─────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── App ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Email Verification ───────────────────────────────────────
# true  = send real verification email via SMTP (same as production hosting).
# false = print the verification link in backend logs only (no SMTP needed).
MAIL_ENABLED=true

# SMTP settings (only used when MAIL_ENABLED=true)
# Example: Gmail with an App Password (enable 2FA on your Google account first)
#   MAIL_SMTP_HOST=smtp.gmail.com
#   MAIL_SMTP_PORT=587
#   MAIL_SMTP_USER=you@gmail.com
#   MAIL_SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx   (16-char App Password, NOT your Gmail password)
#
# Example: SendGrid SMTP relay
#   MAIL_SMTP_HOST=smtp.sendgrid.net
#   MAIL_SMTP_PORT=587
#   MAIL_SMTP_USER=apikey
#   MAIL_SMTP_PASSWORD=SG.xxxxxxxx
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
# Often must match your SMTP login (e.g. same as MAIL_SMTP_USER for Gmail).
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TradeCore

# Public URL users type in the browser — links in emails point here.
# Local: http://localhost:3000   |   Production: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# Token lifetime and resend cooldown
VERIFICATION_TOKEN_EXPIRE_MINUTES=60
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
